{
    "name": "synthetic-sitemap-empty",
    "description": "Search1API /sitemap with no discoverable links (200 + links: []). Unbilled on the Monid side. Hand-built from the vendor's documented shape.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}",
                "body": {
                    "url": "https://example.com",
                    "type": "sitemap"
                }
            },
            "res": {
                "status": 200,
                "body": {
                    "links": []
                }
            }
        }
    ]
}
