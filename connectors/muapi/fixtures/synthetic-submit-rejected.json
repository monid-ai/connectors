{
    "name": "synthetic-submit-rejected",
    "description": "MuAPI rejects a submit with a normal HTTP error. No prediction exists and usage is zero.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 401,
                "body": {
                    "error": {
                        "code": "invalid_api_key",
                        "message": "invalid api key"
                    }
                }
            }
        }
    ]
}
