                        },
                        "open_interest": {
                            "exchange": "exchange-1",
                            "open_interest_amount": 1,
                            "open_interest_usd": 1,
                            "pair": "pair-1",
                            "timestamp": 1
                        },
                        "pair": "pair-1"
                    },
