{
    "name": "detect",
    "description": "Detector on a 15-word text: 200 with the score and 15 words charged. Recorded 2026-09-23; `remainingCredits` replaced by a placeholder.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 200,
                "body": {
                    "howLikelyToBeDetected": 100,
                    "wordsSpent": 15,
                    "remainingCredits": 985000,
                    "billingMode": "prepaid",
                    "meteredChargedCredits": 0
                }
            }
        }
    ]
}
