{
    "name": "pay-per-event-lagging-pages",
    "description": "A PAY_PER_EVENT run whose terminal record carries a LAGGING usageTotalUsd ($0.0001 - the aggregation had not landed) while the dataset already holds 60 profiles. Reconstruction from the total computes ~0 pages, but the delivered profiles themselves prove ceil(60/25) = 3 charged pages (a page yields at most 25 profiles) - the lag-independent floor wins and the derived fold settles 3 pages.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 201,
                "body": {
                    "data": {
                        "id": "RUN1",
                        "status": "RUNNING",
                        "defaultDatasetId": "DS1"
                    }
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/v2/actor-runs/RUN1"
            },
