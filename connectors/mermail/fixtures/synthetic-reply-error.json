{
    "name": "synthetic-reply-error",
    "description": "Synthetic mermail#mailboxes/{mailboxId}/emails/{emailId}/reply 401. Vendor non-2xx settles at zero credits.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "https://console.mermail.app/api/v1/mailboxes/mb_public_1/emails/em_1/reply",
                "body": {
                    "to": "ada@example.com",
                    "from": "agent@mermail.app",
                    "subject": "Hello",
                    "text": "Hello from Mermail"
                }
            },
            "res": {
                "status": 401,
                "body": {
                    "error": "Unauthorized",
                    "code": "api_key_required"
                }
            }
        }
    ]
}
