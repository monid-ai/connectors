{
    "name": "synthetic-call-anchor-transcript",
    "description": "The artifact anchor: pair-verify the call on a read-only GET /calls/{id}, THEN fetch the transcript (the artifact response carries no numberId - the anchor is where the check lives).",
    "calls": [
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/calls/call-1"
            },
            "res": {
                "status": 200,
                "body": {
                    "id": "call-1",
                    "numberId": "num-1",
                    "direction": "outbound",
                    "to": "+14155550123",
                    "from": "+14155559999",
                    "status": "completed",
                    "rateCentsPerMin": 26,
                    "createdAt": "2026-09-16T01:00:00Z",
                    "durationSec": 53,
                    "costCents": 25
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/calls/call-1/transcript"
            },
            "res": {
                "status": 200,
                "body": {
                    "callId": "call-1",
                    "turns": [
                        {
                            "role": "assistant",
                            "text": "Hello!"
                        }
                    ]
                }
            }
        }
    ]
}
