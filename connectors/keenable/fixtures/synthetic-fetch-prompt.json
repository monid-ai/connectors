{
    "name": "synthetic-fetch-prompt",
    "description": "SYNTHETIC bounded fetch for keenable#v1/fetch with a 2000-character prompt (schema-gate near-twin of prompt length 2001). Response shape matches the indexed-fetch public twin; query string is the engine's URLSearchParams encoding.",
    "calls": [
        {
            "req": {
                "method": "GET",
                "url": "https://api.keenable.ai/v1/fetch?url=https%3A%2F%2Fexample.com&"
            },
            "res": {
                "status": 200,
                "body": {
                    "url": "https://example.com/",
                    "title": "Example Domain",
                    "content": "x",
                    "description": ""
                }
            }
        }
    ]
}
