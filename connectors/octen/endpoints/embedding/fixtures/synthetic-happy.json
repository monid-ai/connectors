{
    "name": "synthetic-happy",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "https://api.octen.ai/embedding",
                "body": {
                    "input": ["hello world"],
                    "model": "octen-embedding-4b"
                }
            },
            "res": {
                "status": 200,
                "body": {
                    "data": [{ "embedding": [0.1, 0.2, 0.3], "index": 0 }],
                    "meta": { "usage": { "input_tokens": 2 } }
                }
            }
        }
    ]
}
