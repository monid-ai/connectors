{
    "name": "synthetic-happy",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "https://api.octen.ai/extract",
                "body": {
                    "urls": [
                        "https://example.com/a",
                        "https://example.com/broken"
                    ]
                }
            },
            "res": {
                "status": 200,
                "body": {
                    "results": [
                        {
                            "url": "https://example.com/a",
                            "status": "success",
                            "content": "# A"
                        },
                        {
                            "url": "https://example.com/broken",
                            "status": "failed",
                            "error_message": "timeout"
                        }
                    ],
                    "meta": {
                        "usage": { "successful_urls": 1, "total_urls": 2 }
                    }
                }
            }
        }
    ]
}
