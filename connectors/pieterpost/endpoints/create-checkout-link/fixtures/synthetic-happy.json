{
    "name": "synthetic-happy",
    "description": "SYNTHETIC — shaped from PieterPost's public API docs on 2026-09-22. A test-mode text-letter checkout; ids are placeholders.",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "https://pieterpost.com/v1/checkout-links",
                "body": {
                    "requestType": "letter",
                    "letters": [
                        {
                            "message": "Thanks for your order.",
                            "recipient": {
                                "name": "Pieter Example",
                                "streetAddress": "Damrak 1",
                                "postalCode": "1012 LG",
                                "city": "Amsterdam",
                                "country": "NL"
                            }
                        }
                    ],
                    "locale": "en",
                    "paymentMethod": "auto",
                    "returnUrl": "https://example.com/pieterpost-return",
                    "senderEmail": "sender@example.com"
                }
            },
            "res": {
                "status": 201,
                "body": {
                    "amountCents": 300,
                    "billingMode": "hosted_checkout",
                    "checkoutUrl": "https://pieterpost.com/v1/sandbox/checkout/ord_synthetic_123",
                    "createdAt": "2026-09-22T12:00:00.000Z",
                    "currency": "eur",
                    "error": null,
                    "expiresAt": "2026-09-23T12:00:00.000Z",
                    "externalId": null,
                    "fulfilledAt": null,
                    "metadata": {},
                    "orderId": "ord_synthetic_123",
                    "orderRef": "00000000-0000-4000-8000-000000000123",
                    "paidAt": null,
                    "paymentReference": null,
                    "publicCheckoutUrl": null,
                    "recipientCount": 1,
                    "requestType": "letter",
                    "senderEmail": "sender@example.com",
                    "status": "checkout_open",
                    "testMode": true,
                    "updatedAt": "2026-09-22T12:00:00.000Z"
                }
            }
        }
    ]
}
