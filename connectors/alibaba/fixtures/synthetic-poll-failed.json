{
    "name": "synthetic-poll-failed",
    "description": "SYNTHETIC: the submit succeeds, then OUR task query answers 503. The task is very likely still generating and still billing upstream, so the poll THROWS (retriable) rather than settling a provider error and abandoning a video we are paying for (bytedance D7).",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 200,
                "body": {
                    "output": {
                        "task_status": "PENDING",
                        "task_id": "TASK1"
                    },
                    "request_id": "req-TASK1-submit"
                }
            }
        },
        {
            "req": {
                "method": "GET",
                "url": "{{request.origin}}/api/v1/tasks/TASK1"
            },
            "res": {
                "status": 503,
                "body": {
                    "code": "InternalError",
                    "message": "service unavailable",
                    "request_id": "req-503"
                }
            }
        }
    ]
}
